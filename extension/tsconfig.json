{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "../src/lib/capture/detect.ts",
    "../src/lib/capture/snapshot.ts",
    "../src/lib/capture/search-engines.ts",
    "../src/lib/ai/text.ts"
  ]
}
